# Experimental branch: Mihomo packet_rewrite, cgroup and TC socket assignment.
CONFIG_BPF=y
CONFIG_BPF_SYSCALL=y
CONFIG_BPF_JIT=y
CONFIG_BPF_UNPRIV_DEFAULT_OFF=y
CONFIG_CGROUPS=y
CONFIG_CGROUP_BPF=y
CONFIG_IPV6=y
CONFIG_NET_NS=y
CONFIG_VETH=y
CONFIG_TUN=y
CONFIG_IP_ADVANCED_ROUTER=y
CONFIG_IP_MULTIPLE_TABLES=y
CONFIG_IPV6_MULTIPLE_TABLES=y
CONFIG_NET_CLS_BPF=y
CONFIG_NET_SCH_INGRESS=y
CONFIG_NET_CLS_ACT=y
# Preserve the phone's WALT scheduler.
CONFIG_SCHED_WALT=y
