+# LineageOS SDM845 4.9 adaptations
+
+Source: Hybrid-Mount/meta-hybrid_mount dev @ 1af06a616e1278be7fbf496b16e2b44e1862e2eb, module/vfs/src.
+
+- In-tree Makefile retains upstream gnu11 flags and builds CONFIG_HYBRIDMOUNT.
+- HYBRIDMOUNT_HAS_STATX selects the four-argument getattr ABI backported to this kernel.
+- Include linux/slab.h explicitly for kmalloc/kzalloc/kfree declarations.
+- Kconfig requires KEYS for the keyring control interface.
+- Retain upstream hm1 protocol, magic, UID/rule layout and module identity.
+- LICENSE, PROVENANCE and UPSTREAM_README.md are retained from the upstream source snapshot.
+- Reconstruct qstr from the pinned legacy name_snapshot string during reference revalidation; retain parent/name sequence retry and reference release.
diff --git a/fs/hybridmount/Makefile b/fs/hybridmount/Makefile
new file mode 100644
index 0000000..773ecc8
--- /dev/null
+++ b/fs/hybridmount/Makefile
@@ -0,0 +1,7 @@
+# SPDX-License-Identifier: GPL-2.0-only
+obj-$(CONFIG_HYBRIDMOUNT) += hybridmount.o
+ccflags-y += -std=gnu11 -Wno-declaration-after-statement
+# LineageOS SDM845 4.9 carries the statx/getattr ABI backport.
+ccflags-y += -DHYBRIDMOUNT_HAS_STATX
+# 4.9 name_snapshot stores a pinned C string, not a qstr.
+ccflags-y += -DHYBRIDMOUNT_LEGACY_NAME_SNAPSHOT
