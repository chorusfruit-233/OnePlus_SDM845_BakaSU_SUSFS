+# SPDX-License-Identifier: GPL-2.0-only
+#
+# Kconfig for the Hybrid Mount VFS kernel subsystem (`hybridmount`)
+
+config HYBRIDMOUNT
+	tristate "Hybrid Mount VFS Path Redirection Subsystem"
+	depends on KEYS
+	default y
+	help
+	  Hybrid Mount's VFS path redirection subsystem. It injects, hides and
+	  redirects paths without mounting filesystems, and is driven by the Hybrid
+	  Mount metamodule over the keyring. It is not compatible with NoMount's
+	  metamodule or its tooling.
