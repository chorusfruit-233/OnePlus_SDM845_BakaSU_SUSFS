diff --git a/kernel/Kconfig b/kernel/Kconfig
index 79bc79ee..f5797ec2 100644
--- a/kernel/Kconfig
+++ b/kernel/Kconfig
@@ -233,6 +233,13 @@ config KSU_SUSFS_OPEN_REDIRECT
