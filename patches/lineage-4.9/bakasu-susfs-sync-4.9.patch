SUSFS priority UID filter integration for BakaSU main / Linux 4.9

Upstream: simonpunk/susfs4ksu @ a0ac906915c8a8d50d474dfb3cae478ef32edc1a
BakaSU reviewed: 516d3e87fbc986ccefdde2c2765f1700612441a9
Route the root-only command and refresh mappings after package scans.
Expose the upstream priority-filter option and guard every optional caller.
---
diff --git a/kernel/Kconfig b/kernel/Kconfig
--- a/kernel/Kconfig
+++ b/kernel/Kconfig
@@ -233,6 +233,13 @@
         - Please be reminded that process with open access to the target and redirected path can be detected.
         - Effective only on processes with uid < 2000.
 
+config KSU_SUSFS_PRIORITY_UID_FILTER
+    bool "Enable application UID priority filter"
+    depends on KSU_SUSFS
+    default y
+    help
+        Resolve configured packages from packages.list for priority UID filtering.
+
 config KSU_SUSFS_SUS_MAP
     bool "Enable hiding some mmapped real files from different proc maps interfaces"
     depends on KSU_SUSFS
diff --git a/kernel/manager/throne_tracker.c b/kernel/manager/throne_tracker.c
