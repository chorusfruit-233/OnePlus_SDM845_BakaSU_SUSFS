 	return ret;
 }
 
+/* The bucket lock makes lookup and removal one operation relative to updates
+ * and deletes. Keep the existing LRU lock ordering: return the node only after
+ * dropping the bucket lock, as htab_lru_map_delete_elem() does.
+ */
+static int htab_map_lookup_and_delete_elem(struct bpf_map *map, void *key,
+					 void *value)
+{
+	struct bpf_htab *htab = container_of(map, struct bpf_htab, map);
+	struct htab_elem *l;
+	struct bucket *b;
+	unsigned long flags;
+	u32 hash;
+	int ret = -ENOENT;
+
+	WARN_ON_ONCE(!rcu_read_lock_held());
+	hash = htab_map_hash(key, map->key_size, htab->hashrnd);
+	b = __select_bucket(htab, hash);
+	raw_spin_lock_irqsave(&b->lock, flags);
+	l = lookup_elem_raw(&b->head, hash, key, map->key_size);
+	if (l) {
+		memcpy(value, l->key + round_up(map->key_size, 8),
+		       map->value_size);
+		hlist_nulls_del_rcu(&l->hash_node);
+		if (!htab_is_lru(htab))
+			free_htab_elem(htab, l);
+		ret = 0;
+	}
+	raw_spin_unlock_irqrestore(&b->lock, flags);
+	if (l && htab_is_lru(htab))
+		bpf_lru_push_free(&htab->lru, &l->lru_node);
+	return ret;
+}
