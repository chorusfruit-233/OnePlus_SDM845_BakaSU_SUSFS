diff --git a/kernel/tools/code_generation/preinit_runner/preinit_runner.mk b/kernel/tools/code_generation/preinit_runner/preinit_runner.mk
index 87afec1e..c26407aa 100644
--- a/kernel/tools/code_generation/preinit_runner/preinit_runner.mk
+++ b/kernel/tools/code_generation/preinit_runner/preinit_runner.mk
@@ -4,8 +4,9 @@
 KSU_UAPI_INC := $(objtree)/usr/include
 
 ifeq ($(wildcard $(KSU_UAPI_INC)/linux/unistd.h),)
+# Do not inherit the outer O= build's KBUILD_SRC when re-entering srctree.
 KSU_HEADERS_INSTALL_OUTPUT := $(shell $(MAKE) -s -C "$(abspath $(srctree))" \
-	O="$(abspath $(objtree))" ARCH="$(ARCH)" \
+	KBUILD_SRC= O="$(abspath $(objtree))" ARCH="$(ARCH)" \
 	headers_install INSTALL_HDR_PATH="$(abspath $(objtree))/usr")
 endif
 
@@ -47,7 +48,6 @@ targets += preinit/runner.elf
 $(obj)/preinit/blob.o: $(KSU_RUNNER_TARGET)
 asflags-y += -DKSU_PREINIT_RUNNER_BIN=\"$(KSU_RUNNER_BIN)\"
 else
-$(warning -- $(REPO_NAME): $(KSU_UAPI_INC) not found, preinit disabled)
-ccflags-y += -DKSU_NO_PREINIT
+$(error -- $(REPO_NAME): install target UAPI headers to build the required preinit runner)
 endif
 
diff --git a/kernel/tools/kernel_compat.mk b/kernel/tools/kernel_compat.mk
index 39e5ab9b..db858f38 100644
--- a/kernel/tools/kernel_compat.mk
+++ b/kernel/tools/kernel_compat.mk
@@ -359,12 +359,14 @@ $(info -- $(REPO_NAME)/compat: found KERNEL_PARAM_FL_NOARG)
 ccflags-y += -DKSU_COMPAT_HAS_KERNEL_PARAM_FL_NOARG
 endif
 
-ifeq ($(shell grep -q "ksu_handle_init_module" $(srctree)/kernel/module/main.c 2>/dev/null; echo $$?),0)
+# Legacy kernels keep the two module syscalls in kernel/module.c.
+KSU_MODULE_SOURCE := $(firstword $(wildcard $(srctree)/kernel/module/main.c $(srctree)/kernel/module.c))
+ifeq ($(shell grep -q "ksu_handle_init_module" $(KSU_MODULE_SOURCE) 2>/dev/null; echo $$?),0)
   $(info -- $(REPO_NAME)/compat: found ksu_handle_init_module)
-  ifeq ($(shell grep -q "ksu_handle_finit_module" $(srctree)/kernel/module/main.c 2>/dev/null; echo $$?),0)
+  ifeq ($(shell grep -q "ksu_handle_finit_module" $(KSU_MODULE_SOURCE) 2>/dev/null; echo $$?),0)
     $(info -- $(REPO_NAME)/compat: found ksu_handle_finit_module)
     ccflags-y += -DKSU_COMPAT_HAS_INSMOD_HOOK
   else
     $(error You must hook both init_module and finit_module if you want module blacklist)
   endif
-endif
\ No newline at end of file
+endif
