+/* Socket helpers retain a real reference for every 4.9 lookup result,
+ * including RCU-freed UDP/listening sockets. This matches the existing
+ * skb_steal_sock() and TCP/UDP receive paths, which always put that reference.
+ */
+#ifdef CONFIG_INET
+static struct sock *bpf_sk_lookup_core(struct sk_buff *skb,
+				     struct bpf_sock_tuple *tuple, u32 len,
+				     u8 proto, u64 netns_id, u64 flags)
+{
+	struct net *caller_net, *net;
+	struct sock *sk = NULL;
+	bool refcounted = false;
+	int ifindex;
+
+	if ((len != sizeof(tuple->ipv4) && len != sizeof(tuple->ipv6)) ||
+	    flags || !((s32)netns_id < 0 || netns_id <= S32_MAX))
+		return NULL;
+	if (skb->dev) {
+		caller_net = dev_net(skb->dev);
+		ifindex = skb->dev->ifindex;
+	} else if (skb->sk) {
+		caller_net = sock_net(skb->sk);
+		ifindex = 0;
+	} else {
+		return NULL;
+	}
+	if ((s32)netns_id < 0)
+		net = caller_net;
+	else {
+		net = get_net_ns_by_id(caller_net, netns_id);
+		if (!net)
+			return NULL;
+	}
+
+	if (len == sizeof(tuple->ipv4)) {
+		if (proto == IPPROTO_TCP)
+			sk = __inet_lookup(net, &tcp_hashinfo, NULL, 0,
+					   tuple->ipv4.saddr, tuple->ipv4.sport,
+					   tuple->ipv4.daddr, tuple->ipv4.dport,
+					   ifindex, &refcounted);
+		else
+			sk = __udp4_lib_lookup(net, tuple->ipv4.saddr,
+					       tuple->ipv4.sport, tuple->ipv4.daddr,
+					       tuple->ipv4.dport, ifindex,
+					       &udp_table, NULL);
+#if IS_ENABLED(CONFIG_IPV6)
+	} else if (ipv6_stub->bpf_sk_lookup) {
+		sk = ipv6_stub->bpf_sk_lookup(net, tuple, ifindex, proto,
+					    &refcounted);
+#endif
+	}
+	if (sk && !refcounted && !atomic_inc_not_zero(&sk->sk_refcnt))
+		sk = NULL;
+	if ((s32)netns_id >= 0)
+		put_net(net);
+	return sk;
+}
