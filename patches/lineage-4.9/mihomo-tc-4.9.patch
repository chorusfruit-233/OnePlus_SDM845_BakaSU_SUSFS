+
+		if (!atomic_inc_not_zero(&listener->sk_refcnt))
+			listener = NULL;
+		sock_gen_put(sk);
+		sk = listener;
+	}
+	if (sk && !sk_fullsock(sk)) {
+		sock_gen_put(sk);
+		sk = NULL;
+	}
+	return (unsigned long)sk;
+}
