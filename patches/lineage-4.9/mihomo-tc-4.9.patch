+static struct sock *bpf_sk_lookup_v6(struct net *net,
+				     struct bpf_sock_tuple *tuple, int dif,
+				     u8 proto, bool *refcounted)
+{
+	const struct in6_addr *src = (const void *)tuple->ipv6.saddr;
+	const struct in6_addr *dst = (const void *)tuple->ipv6.daddr;
+
+	if (proto == IPPROTO_TCP)
+		return __inet6_lookup(net, &tcp_hashinfo, NULL, 0,
+				      src, tuple->ipv6.sport,
+				      dst, ntohs(tuple->ipv6.dport), dif,
+				      refcounted);
+	*refcounted = false;
+	return __udp6_lib_lookup(net, src, tuple->ipv6.sport,
+				 dst, tuple->ipv6.dport, dif, &udp_table, NULL);
+}
