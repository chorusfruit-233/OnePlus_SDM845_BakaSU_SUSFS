+/* This bounded backport exposes only the two common fields needed by
+ * Mihomo. Full-socket-only fields and all writes remain rejected.
+ */
+bool bpf_sock_common_is_valid_access(int off, int size,
+				     enum bpf_access_type type,
+				     struct bpf_insn_access_aux *info)
+{
+	if (type != BPF_READ || size != sizeof(__u32))
+		return false;
+	switch (off) {
+	case offsetof(struct bpf_sock, family):
+	case offsetof(struct bpf_sock, state):
+		bpf_ctx_record_field_size(info, sizeof(__u32));
+		return true;
+	default:
+		return false;
+	}
+}
+
+u32 bpf_sock_convert_ctx_access(enum bpf_access_type type,
+			       const struct bpf_insn *si,
+			       struct bpf_insn *insn_buf,
+			       struct bpf_prog *prog, u32 *target_size)
+{
+	struct bpf_insn *insn = insn_buf;
+
+	switch (si->off) {
+	case offsetof(struct bpf_sock, family):
+		*insn++ = BPF_LDX_MEM(BPF_H, si->dst_reg, si->src_reg,
+				      bpf_target_off(struct sock_common, skc_family,
+						     FIELD_SIZEOF(struct sock_common, skc_family),
+						     target_size));
+		break;
+	case offsetof(struct bpf_sock, state):
+		*insn++ = BPF_LDX_MEM(BPF_B, si->dst_reg, si->src_reg,
+				      bpf_target_off(struct sock_common, skc_state,
+						     FIELD_SIZEOF(struct sock_common, skc_state),
+						     target_size));
+		break;
+	}
+	return insn - insn_buf;
+}
