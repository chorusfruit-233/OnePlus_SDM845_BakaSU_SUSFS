-    if ((payload = (void *)((char *)kmap(page) + pg_off))->magic != HYBRIDMOUNT_MAGIC_SIG) {
+    /* Pinning prevents unmapping, not concurrent writes. Parse an owned
+     * snapshot so a second thread cannot change lengths after validation. */
+    mapped = (char *)kmap(page) + pg_off;
