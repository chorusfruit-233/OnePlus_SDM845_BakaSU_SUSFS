+
+# Only the pinned Lineage 4.9 ARM64 port has been reviewed for the NonGKI
+# automatic SELinux hooks. prepare-sources.sh writes this marker after checking
+# the kernel ABI and the adaptation patch; it does not certify device testing.
+SUSFS_4_9_AUTO_REVIEWED := $(shell \
+    test "$(VERSION).$(PATCHLEVEL)" = "4.9" && \
+    test "$(CONFIG_ARM64)" = "y" && \
+    test "$(CONFIG_KSU)" = "y" && \
+    test "$(CONFIG_KALLSYMS_ALL)" = "y" && \
