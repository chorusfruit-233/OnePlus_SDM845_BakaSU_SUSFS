diff --git a/include/linux/bpf_legacy_compat.h b/include/linux/bpf_legacy_compat.h
new file mode 100644
index 0000000..c80933d
--- /dev/null
+++ b/include/linux/bpf_legacy_compat.h
@@ -0,0 +1,67 @@
+/* SPDX-License-Identifier: GPL-2.0 */
+#ifndef _LINUX_BPF_LEGACY_COMPAT_H
+#define _LINUX_BPF_LEGACY_COMPAT_H
+#include <linux/slab.h>
+#include <linux/vmalloc.h>
+#include <linux/overflow.h>
+#include <asm/barrier.h>
+#include <asm/pgtable.h>
+
+/* Keep the vmalloc fallback local to BPF; 4.9 already provides kvfree(). */
+static inline void *bpf_legacy_kvmalloc(size_t size, gfp_t flags)
+{
+	gfp_t kmalloc_flags = flags;
+	void *p;
+
+	if ((flags & GFP_KERNEL) != GFP_KERNEL)
+		return kmalloc(size, flags);
+	if (size > PAGE_SIZE)
+		kmalloc_flags |= __GFP_NOWARN | __GFP_NORETRY;
+	p = kmalloc(size, kmalloc_flags);
+	if (p || size <= PAGE_SIZE)
+		return p;
+	return __vmalloc(size, flags, PAGE_KERNEL);
+}
+
+static inline void *bpf_legacy_kvzalloc(size_t size, gfp_t flags)
+{
+	return bpf_legacy_kvmalloc(size, flags | __GFP_ZERO);
+}
+
+static inline void *bpf_legacy_kvcalloc(size_t n, size_t size, gfp_t flags)
+{
+	size_t bytes;
+
+	if (check_mul_overflow(n, size, &bytes))
+		return NULL;
+	return bpf_legacy_kvzalloc(bytes, flags);
+}
+static inline int bpf_legacy_atomic_fetch_add_unless(atomic_t *v, int add, int unless)
+{
+	int old = atomic_read(v);
+
+	for (;;) {
+		int seen;
+
+		if (old == unless)
+			return old;
+		seen = atomic_cmpxchg(v, old, (unsigned int)old + add);
+		if (seen == old)
+			return old;
+		old = seen;
+	}
+}
+
+static inline size_t bpf_legacy_array_size(size_t a, size_t b)
+{
+	size_t result;
+
+	return check_mul_overflow(a, b, &result) ? SIZE_MAX : result;
+}
+#ifndef array_size
+#define array_size(a, b) bpf_legacy_array_size(a, b)
+#endif
+#if defined(CONFIG_ARM64) && !defined(barrier_nospec)
+#define barrier_nospec() csdb()
+#endif
+#endif
