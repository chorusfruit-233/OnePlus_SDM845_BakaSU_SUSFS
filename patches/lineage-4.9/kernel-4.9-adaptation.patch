@@ -791,7 +799,48 @@ static ssize_t store_##file_name					\
 	return ret ? ret : count;					\
 }
 
-store_one(scaling_min_freq, min);
+static ssize_t store_scaling_min_freq(struct cpufreq_policy *policy,
+				      const char *buf, size_t count)
+{
+	struct cpufreq_policy new_policy;
+	unsigned int limit, requested;
+	int ret;
+
+	ret = sscanf(buf, "%u", &requested);
+	if (ret != 1)
+		return -EINVAL;
+
+	limit = per_cpu(cpufreq_min_freq_limit, policy->cpu);
+	if (limit)
+		requested = min(requested, limit);
+
+	memcpy(&new_policy, policy, sizeof(*policy));
+	new_policy.min = requested;
+	new_policy.max = policy->user_policy.max;
+	ret = cpufreq_set_policy(policy, &new_policy);
+	if (!ret)
+		policy->user_policy.min = requested;
+
+	return ret ? ret : count;
+}
+
+static ssize_t store_scaling_min_freq_limit(struct cpufreq_policy *policy,
+					    const char *buf, size_t count)
+{
+	unsigned int cpu, limit;
+
+	if (sscanf(buf, "%u", &limit) != 1)
+		return -EINVAL;
+	if (limit && (limit < policy->cpuinfo.min_freq ||
+		      limit > policy->cpuinfo.max_freq))
+		return -EINVAL;
+
+	for_each_cpu(cpu, policy->related_cpus)
+		per_cpu(cpufreq_min_freq_limit, cpu) = limit;
+
+	return count;
+}
+
 store_one(scaling_max_freq, max);
 
 /**
