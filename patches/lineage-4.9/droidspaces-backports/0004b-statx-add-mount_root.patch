From e4a0c17deedf18fa2a50251dcd4028666a588ab2 Mon Sep 17 00:00:00 2001
From: Miklos Szeredi <mszeredi@redhat.com>
Date: Tue, 27 Oct 2026 19:48:10 +0000
Subject: [PATCH] statx: add mount_root

Determining whether a path or file descriptor refers to a mountpoint (or
more precisely a mount root) is not trivial using current tools.

Add a flag to statx that indicates whether the path or fd refers to the
root of a mount or not.

Cc: linux-api@vger.kernel.org
Cc: linux-man@vger.kernel.org
Reported-by: Lennart Poettering <mzxreary@0pointer.de>
Reported-by: J. Bruce Fields <bfields@fieldses.org>
Signed-off-by: Miklos Szeredi <mszeredi@redhat.com>
Reviewed-by: Christoph Hellwig <hch@lst.de>
(cherry picked from commit 80340fe3605c0e78cfe496c3b3878be828cfdbfe)

Backport to LineageOS SDM845 4.9: the existing statx predates stx_attributes_mask. Add that field at the reserved ABI offset, initialise the supported automount mask, and report mount-root status for path and fd queries.

Signed-off-by: 16384 Misaka <chorus.fruit.472@gmail.com>
---
 fs/stat.c                 | 6 +++++-
 include/linux/stat.h      | 1 +
 include/uapi/linux/stat.h | 3 ++-
 3 files changed, 8 insertions(+), 2 deletions(-)

diff --git a/fs/stat.c b/fs/stat.c
index 36b4a2f..0de3910 100644
--- a/fs/stat.c
+++ b/fs/stat.c
@@ -85,6 +85,7 @@ int vfs_getattr_nosec(const struct path *path, struct kstat *stat,
 
 	memset(stat, 0, sizeof(*stat));
 	stat->result_mask |= STATX_BASIC_STATS;
+	stat->attributes_mask = STATX_ATTR_AUTOMOUNT;
 	request_mask &= STATX_ALL;
 	query_flags &= KSTAT_QUERY_FLAGS;
 #ifdef CONFIG_KSU_SUSFS_SUS_KSTAT
@@ -140,6 +141,9 @@ static void statx_set_mount_info(struct kstat *stat, const struct path *path)
 {
 	stat->mnt_id = real_mount(path->mnt)->mnt_id;
 	stat->result_mask |= STATX_MNT_ID;
+	if (path->mnt->mnt_root == path->dentry)
+		stat->attributes |= STATX_ATTR_MOUNT_ROOT;
+	stat->attributes_mask |= STATX_ATTR_MOUNT_ROOT;
 }
 
 /**
@@ -611,7 +615,7 @@ static long statx_set_result(struct kstat *stat, struct statx __user *buffer)
 	    __put_user(stat->ino,		&buffer->stx_ino	) ||
 	    __put_user(stat->size,		&buffer->stx_size	) ||
 	    __put_user(stat->blocks,		&buffer->stx_blocks	) ||
-	    __clear_user(&buffer->__spare1, sizeof(buffer->__spare1))	  ||
+	    __put_user(stat->attributes_mask, &buffer->stx_attributes_mask) ||
 	    __put_user(stat->mnt_id,	&buffer->stx_mnt_id	) ||
 	    __put_user(0,		&buffer->__spare2	) ||
 	    __clear_user(&buffer->__spare3, sizeof(buffer->__spare3)))
diff --git a/include/linux/stat.h b/include/linux/stat.h
index 62ff4a0..a82452c 100644
--- a/include/linux/stat.h
+++ b/include/linux/stat.h
@@ -26,6 +26,7 @@ struct kstat {
 	unsigned int	nlink;
 	uint32_t	blksize;	/* Preferred I/O size */
 	u64		attributes;
+	u64		attributes_mask;
 #define KSTAT_ATTR_FS_IOC_FLAGS				\
 	(STATX_ATTR_COMPRESSED |			\
 	 STATX_ATTR_IMMUTABLE |				\
diff --git a/include/uapi/linux/stat.h b/include/uapi/linux/stat.h
index 171434a..e084371 100644
--- a/include/uapi/linux/stat.h
+++ b/include/uapi/linux/stat.h
@@ -114,7 +114,7 @@ struct statx {
 	__u64	stx_ino;	/* Inode number */
 	__u64	stx_size;	/* File size */
 	__u64	stx_blocks;	/* Number of 512-byte blocks allocated */
-	__u64	__spare1[1];
+	__u64	stx_attributes_mask;	/* Supported attribute bits */
 	/* 0x40 */
 	struct statx_timestamp	stx_atime;	/* Last access time */
 	struct statx_timestamp	stx_btime;	/* File creation time */
@@ -175,6 +175,7 @@ struct statx {
 #define STATX_ATTR_ENCRYPTED		0x00000800 /* [I] File requires key to decrypt in fs */
 
 #define STATX_ATTR_AUTOMOUNT		0x00001000 /* Dir: Automount trigger */
+#define STATX_ATTR_MOUNT_ROOT		0x00002000 /* Root of a mount */
 
 
 #endif /* _UAPI_LINUX_STAT_H */
